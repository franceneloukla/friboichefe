{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python3 scripts/build_vercel.py || python scripts/build_vercel.py",
  "outputDirectory": "public",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "{server/**,data/catalog.json,data/seed.db}"
    }
  },
  "rewrites": [
    {
      "source": "/((?!assets/|static/|img/|favicon).*)",
      "destination": "/api/index/$1"
    }
  ]
}
