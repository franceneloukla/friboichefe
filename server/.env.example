# Friboi Online — variáveis de ambiente do backend
# Copie para server/.env (ou exporte no shell) e ajuste.

# Chave de assinatura do JWT (HS256). OBRIGATÓRIO trocar em produção.
SECRET_KEY=dev-secret-friboi-online-troque-em-producao
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# Cookies
# 1 = cookie auth_token apenas em HTTPS (produção); 0 = também em HTTP local
COOKIE_SECURE=0
COOKIE_SAMESITE=lax

# Banco — DB-agnóstico.
# Sem DATABASE_URL o app usa SQLite local em <projeto>/data/store.db.
# Com DATABASE_URL (Vercel/Heroku/Railway) usa Postgres: "postgres://" é convertido
# automaticamente para "postgresql+psycopg2://" e o engine ganha pool_pre_ping +
# pool_recycle=280. Requer psycopg2-binary nas dependências.
# DATABASE_URL=postgres://usuario:senha@host:5432/banco
# DB_PATH=./data/store.db
# DATA_DIR=./data
SQL_ECHO=0

# 1 = no boot, se a tabela products estiver vazia e o catálogo existir, roda o seed
# (é o que faz o primeiro cold start funcionar no Vercel)
SEED_ON_INIT=1

# Catálogo usado pelo seed (default: <projeto>/data/catalog.json)
# CATALOG_PATH=./data/catalog.json

# 1 = cria o usuário de desenvolvimento admin@loja.local / admin123 no seed
DEV_MODE=1
DEV_ADMIN_EMAIL=admin@loja.local
DEV_ADMIN_PASSWORD=admin123

# Servidor
HOST=127.0.0.1
PORT=8099
